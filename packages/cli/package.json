{
  "name": "@lorepack/cli",
  "version": "0.0.0",
  "description": "The lore command line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "studio-dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@lorepack/backend-local": "workspace:*",
    "@lorepack/compiler": "workspace:*",
    "@lorepack/connect-clients": "workspace:*",
    "@lorepack/core": "workspace:*",
    "@lorepack/deploy-cloudflare": "workspace:*",
    "@lorepack/mcp": "workspace:*",
    "@lorepack/parsers": "workspace:*",
    "@lorepack/runtime": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "hono": "4.12.34"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lore": "./dist/entry.js"
  },
  "devDependencies": {
    "@lorepack/test-support": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
