{
  "name": "@lorepack/cli",
  "version": "0.1.0",
  "description": "The Lorepack command line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/public-index.js"
    }
  },
  "main": "./dist/public-index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "studio-dist"
  ],
  "scripts": {
    "build": "tsc -b && node ../../scripts/bundle-cli.mjs",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "csv-parse": "7.0.2",
    "hono": "4.13.7",
    "jose": "6.2.7",
    "jsonc-parser": "3.3.1",
    "mammoth": "1.12.0",
    "mdast-util-from-markdown": "2.0.2",
    "pdfjs-dist": "6.2.108",
    "rehype-parse": "9.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sax": "1.6.1",
    "smol-toml": "1.9.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/cli"
  },
  "bin": {
    "lorepack": "./dist/public-entry.js"
  },
  "devDependencies": {
    "@lorepack/backend-local": "workspace:*",
    "@lorepack/compiler": "workspace:*",
    "@lorepack/connect-clients": "workspace:*",
    "@lorepack/core": "workspace:*",
    "@lorepack/deploy-cloudflare": "workspace:*",
    "@lorepack/mcp": "workspace:*",
    "@lorepack/parsers": "workspace:*",
    "@lorepack/runtime": "workspace:*",
    "@lorepack/test-support": "workspace:*",
    "wrangler": "4.119.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
