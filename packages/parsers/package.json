{
  "name": "@lorepack/parsers",
  "version": "0.0.0",
  "description": "Built-in artifact parsers for Lorepack.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lorepack/core": "workspace:*",
    "csv-parse": "7.0.2",
    "mammoth": "1.12.0",
    "mdast-util-from-markdown": "2.0.2",
    "pdfjs-dist": "6.2.108",
    "rehype-parse": "9.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "sax": "1.6.1",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/parsers"
  },
  "devDependencies": {
    "@lorepack/test-support": "workspace:*",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/sax": "^1.2.7",
    "@types/unist": "3.0.3",
    "@types/yauzl": "^3.4.0",
    "yazl": "3.3.1"
  }
}
