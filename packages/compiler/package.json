{
  "name": "@lorepack/compiler",
  "version": "0.0.0",
  "description": "Deterministic compiler pipeline and validation for Lorepack.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lorepack/core": "workspace:*",
    "@lorepack/parsers": "workspace:*",
    "picomatch": "4.0.5",
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/compiler"
  },
  "devDependencies": {
    "@lorepack/test-support": "workspace:*",
    "@types/picomatch": "4.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
