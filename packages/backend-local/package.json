{
  "name": "@lorepack/backend-local",
  "version": "0.0.0",
  "description": "node:sqlite and filesystem storage adapters for Lorepack.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lorepack/core": "workspace:*",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/backend-local"
  },
  "devDependencies": {
    "@lorepack/test-support": "workspace:*",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
