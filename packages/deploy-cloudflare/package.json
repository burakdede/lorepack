{
  "name": "@lorepack/deploy-cloudflare",
  "version": "0.0.0",
  "description": "Cloudflare deployment target for Lorepack.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@lorepack/backend-local": "workspace:*",
    "@lorepack/core": "workspace:*",
    "@lorepack/mcp": "workspace:*",
    "@lorepack/runtime": "workspace:*",
    "hono": "4.12.34",
    "jose": "6.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakdede/lorepack.git",
    "directory": "packages/deploy-cloudflare"
  },
  "devDependencies": {
    "wrangler": "4.119.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
