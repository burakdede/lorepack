{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lorepack-runtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["enable_request_signal"],
  "vars": {
    "PROJECT_ID": "demo"
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "lorepack-catalog",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "lorepack-catalog-local",
      "remote": false
    },
    {
      "binding": "TABLES_DB",
      "database_name": "lorepack-tables",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "lorepack-tables-local",
      "remote": false
    }
  ],
  // Table queries per caller (#558). The SQL guard bounds the rows a query can form, not what
  // each row costs, and D1 cannot stop a query before its 30 second limit. Counters are per
  // Cloudflare location and keyed on a hash of the caller's credential.
  "ratelimits": [
    {
      "name": "TABLE_QUERY_LIMITER",
      "namespace_id": "1558",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "lorepack-build-objects",
      "preview_bucket_name": "lorepack-build-objects-local",
      "remote": false
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
