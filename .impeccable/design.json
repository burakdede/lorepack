  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "The one button shape: quiet surface, hairline control border, contrast on hover.",
      "html": "<button class=\"ds-action\">Compare builds</button>",
      "css": ".ds-action{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 12px;font-family:var(--font-sans);font-size:12.5px;font-weight:500;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-panel);cursor:pointer;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out),color 150ms var(--ease-out)}.ds-action:hover{background:var(--surface-raised)}.ds-action:active{transform:translateY(0.5px)}.ds-action:focus-visible{outline:2px solid var(--text);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The confirmed action, weighted by ink contrast rather than colour.",
      "html": "<button class=\"ds-action-primary\">Activate b3f9c2e1</button>",
      "css": ".ds-action-primary{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 12px;font-family:var(--font-sans);font-size:12.5px;font-weight:500;color:var(--ink-text);background:var(--ink);border:1px solid var(--ink);border-radius:8px;cursor:pointer;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out)}.ds-action-primary:hover{background:var(--ink-hover);border-color:var(--ink-hover)}.ds-action-primary:focus-visible{outline:2px solid var(--text);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Shared input and select shape across routes; ink outline on focus.",
      "html": "<input class=\"ds-field\" placeholder=\"Filter paths\" />",
      "css": ".ds-field{height:36px;width:280px;padding:0 12px;font-family:var(--font-sans);font-size:14px;color:var(--text);background:var(--surface);border:1px solid var(--border);border-radius:8px;transition:border-color 150ms var(--ease-out)}.ds-field::placeholder{color:var(--text-muted)}.ds-field:hover{border-color:var(--text-muted)}.ds-field:focus-visible{outline:2px solid var(--text);outline-offset:0;border-color:var(--text)}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Six sections with shell icons; the active one is a raised sheet with weight, not colour.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-link ds-nav-link-active\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"2.5\" y=\"2.5\" width=\"4.5\" height=\"4.5\" rx=\"1\"/><rect x=\"9\" y=\"2.5\" width=\"4.5\" height=\"4.5\" rx=\"1\"/><rect x=\"2.5\" y=\"9\" width=\"4.5\" height=\"4.5\" rx=\"1\"/><rect x=\"9\" y=\"9\" width=\"4.5\" height=\"4.5\" rx=\"1\"/></svg>Overview</a><a class=\"ds-nav-link\" href=\"#\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9.5 1.75H4.25a1 1 0 0 0-1 1v10.5a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1V5Z\"/><path d=\"M9.5 1.75V5h3.25\"/><path d=\"M5.75 8.25h4.5M5.75 10.75h3\"/></svg>Sources</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:224px;padding:12px;background:var(--sidebar)}.ds-nav-link{display:flex;align-items:center;gap:12px;height:34px;padding:0 12px;border-radius:8px;color:var(--text-secondary);font-family:var(--font-sans);font-size:14px;text-decoration:none;transition:background-color 150ms var(--ease-out),color 150ms var(--ease-out)}.ds-nav-link svg{color:var(--text-muted)}.ds-nav-link:hover{background:var(--surface-raised);color:var(--text)}.ds-nav-link-active,.ds-nav-link-active:hover{background:var(--surface);color:var(--text);font-weight:500;box-shadow:inset 0 0 0 1px var(--border-subtle),var(--shadow-panel)}.ds-nav-link-active svg{color:var(--text)}.ds-nav-link:focus-visible{outline:2px solid var(--text);outline-offset:2px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "badge-ok",
      "description": "State pill with a dot beside the word; ok, warn, bad and idle.",
      "html": "<span class=\"ds-badge ds-badge-ok\">fresh</span> <span class=\"ds-badge ds-badge-warn\">stale</span> <span class=\"ds-badge ds-badge-bad\">failed</span> <span class=\"ds-badge ds-badge-idle\">idle</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;height:20px;padding:0 8px;font-family:var(--font-sans);font-size:11.5px;font-weight:500;line-height:1;border-radius:999px;border:1px solid transparent}.ds-badge-ok::before,.ds-badge-warn::before,.ds-badge-bad::before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.ds-badge-ok{color:var(--state-ok);background:var(--state-ok-bg)}.ds-badge-warn{color:var(--state-warn);background:var(--state-warn-bg)}.ds-badge-bad{color:var(--state-bad);background:var(--state-bad-bg)}.ds-badge-idle{color:var(--text-muted);border-color:var(--border)}"
    },
    {
      "name": "Facts Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "One bordered surface per group of evidence holding an aligned key-value list.",
      "html": "<section class=\"ds-panel\"><dl class=\"ds-facts\"><dt>Build</dt><dd>b3f9c2e1a7d4</dd><dt>Artifacts</dt><dd>128</dd><dt>Compiler</dt><dd>0.1.0</dd></dl></section>",
      "css": ".ds-panel{width:420px;background:var(--surface);border:1px solid var(--border-subtle);border-radius:12px;box-shadow:var(--shadow-panel);padding:20px}.ds-facts{margin:0;display:grid;grid-template-columns:minmax(8rem,max-content) minmax(0,1fr);column-gap:24px}.ds-facts dt,.ds-facts dd{margin:0;padding:7px 0;border-bottom:1px solid var(--border-subtle);font-size:12.5px}.ds-facts dt{font-family:var(--font-sans);color:var(--text-muted)}.ds-facts dd{font-family:var(--font-mono);color:var(--text);font-variant-numeric:tabular-nums}.ds-facts dt:nth-last-of-type(1),.ds-facts dd:last-child{border-bottom:0}"
    },
    {
      "name": "Data Table",
      "kind": "custom",
      "refersTo": "data-table-row",
      "description": "Framed table: 36px rows, hairline rules, quiet sunken header, mono numerics.",
      "html": "<div class=\"ds-table-frame\"><table class=\"ds-table\"><thead><tr><th>Path</th><th class=\"ds-num\">Chunks</th></tr></thead><tbody><tr><td>docs/intro.md</td><td class=\"ds-num\">12</td></tr><tr><td>data/plan.xlsx</td><td class=\"ds-num\">4</td></tr></tbody></table></div>",
      "css": ".ds-table-frame{width:420px;background:var(--surface);border:1px solid var(--border-subtle);border-radius:12px;box-shadow:var(--shadow-panel);overflow:hidden}.ds-table{width:100%;border-collapse:collapse;font-size:12.5px}.ds-table th,.ds-table td{height:36px;padding:6px 12px;text-align:left;border-bottom:1px solid var(--border-subtle)}.ds-table td{font-family:var(--font-mono);color:var(--text)}.ds-table thead th{height:34px;font-family:var(--font-sans);font-weight:500;font-size:11.5px;color:var(--text-muted);background:var(--surface-sunken)}.ds-table tbody tr:last-child>*{border-bottom:0}.ds-table tbody tr{transition:background-color 120ms var(--ease-out)}.ds-table tbody tr:hover{background:var(--surface-sunken)}.ds-table .ds-num{text-align:right;font-family:var(--font-mono);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Command Palette",
      "kind": "custom",
      "refersTo": "palette",
      "description": "Signature Cmd-K sheet: overlay shadow, 52px query row, grouped options, highlighted option in selection wash.",
      "html": "<div class=\"ds-palette\"><div class=\"ds-palette-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"><circle cx=\"7.25\" cy=\"7.25\" r=\"4.5\"/><path d=\"m10.5 10.5 3.25 3.25\"/></svg><input class=\"ds-palette-input\" placeholder=\"Jump to a route, source or table\" /></div><ul class=\"ds-palette-list\"><li class=\"ds-palette-group\">Sources</li><li class=\"ds-palette-option ds-palette-option-on\"><span class=\"ds-palette-label\">intro.md</span><span class=\"ds-palette-detail\">docs/intro.md</span></li><li class=\"ds-palette-option\"><span class=\"ds-palette-label\">plan.xlsx</span><span class=\"ds-palette-detail\">data/plan.xlsx</span></li></ul></div>",
      "css": ".ds-palette{width:520px;display:flex;flex-direction:column;background:var(--surface);border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow-overlay);overflow:hidden;animation:ds-rise 180ms var(--ease-out)}.ds-palette-search{display:flex;align-items:center;gap:12px;padding:0 16px;border-bottom:1px solid var(--border-subtle);color:var(--text-muted)}.ds-palette-input{flex:1;height:52px;border:0;background:transparent;font-family:var(--font-sans);font-size:16px;color:var(--text)}.ds-palette-input:focus-visible{outline:none}.ds-palette-list{list-style:none;margin:0;padding:8px}.ds-palette-group{padding:12px 8px 4px;font-size:11.5px;font-weight:500;color:var(--text-muted)}.ds-palette-option{display:flex;align-items:center;gap:12px;min-height:38px;padding:0 12px;border-radius:8px;color:var(--text-secondary);cursor:pointer}.ds-palette-option:hover,.ds-palette-option-on{background:var(--selected);color:var(--text)}.ds-palette-label{flex:1}.ds-palette-detail{font-family:var(--font-mono);font-size:11.5px;color:var(--text-muted)}@keyframes ds-rise{from{opacity:0;transform:translateY(-6px) scale(0.985)}}"
    },
    {
      "name": "Budget Tape",
      "kind": "custom",
      "refersTo": null,
      "description": "Playground's to-scale token accounting, drawn from elements with the exact figures beside it.",
      "html": "<div class=\"ds-tape\"><div class=\"ds-tape-track\"><span class=\"ds-seg ds-reserved\" style=\"width:12%\"></span><span class=\"ds-seg ds-selected\" style=\"width:58%\"></span><span class=\"ds-seg ds-free\" style=\"width:30%\"></span></div><div class=\"ds-tape-legend\"><span>reserved 480</span><span>selected 2,320</span><span>free 1,200</span><span class=\"ds-tape-total\">4,000 tokens</span></div></div>",
      "css": ".ds-tape{width:420px}.ds-tape-track{display:flex;height:10px;overflow:hidden;border-radius:999px;background:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border-subtle)}.ds-seg{height:100%}.ds-seg+.ds-seg{border-left:2px solid var(--surface)}.ds-reserved{background:var(--text-muted)}.ds-selected{background:var(--text)}.ds-free{background:var(--surface-raised);box-shadow:inset 0 0 0 1px var(--border)}.ds-tape-legend{display:flex;flex-wrap:wrap;gap:4px 16px;margin-top:8px;font-family:var(--font-mono);font-size:11.5px;color:var(--text-secondary)}.ds-tape-total{margin-left:auto;color:var(--text-muted)}"
    }
  ],
  "narrative": {
    "northStar": "The Developer Inspector",
    "overview": "Lore Studio sits beside browser DevTools and a terminal without apology. It is a persistent sidebar, a quiet route header, and list and detail panes in which the evidence (paths, build ids, ranges, rows) is the content. Nothing on screen is decoration: a surface exists because it frames one group of evidence, and a mark of colour exists because something has a state.\n\nThe world is restrained neutral zinc in two peer themes, light and dark, each defined once and resolved before first paint. The sidebar sits on a second, slightly offset neutral so the shell reads as furniture and the route reads as the work. There is no accent hue. Selection, focus and the primary action are carried by ink contrast: near-black on light, near-white on dark. Green, amber and red appear only for state, and always beside a word.\n\nDensity is a developer's density: 14px body, 36px rows, 12.5px data in mono with tabular figures, aligned key-value facts that echo what `lorepack build` prints. Motion is limited to 120 to 200ms state changes, the palette rising, and the build id settling when a rebuild lands.",
    "keyCharacteristics": [
      "Neutral zinc, two peer themes, no accent token.",
      "Colour encodes state only, always with a word or a dot beside it.",
      "Hairline 1px borders; 8px controls, 12px panels, pills for status.",
      "IBM Plex Sans for the interface, IBM Plex Mono for every id, path, number and query.",
      "Authored 16px line icons at 1.5 stroke, in the shell only.",
      "One animated moment of truth: the build id settles when a rebuild lands."
    ],
    "rules": [
      {
        "name": "The State-Only Colour Rule",
        "body": "Green, amber and red mean state and nothing else. Every use sits beside a word, and badges add a 6px dot so state survives greyscale. A coloured surface is a state banner or a failure block, never emphasis.",
        "section": "colors"
      },
      {
        "name": "The Ink, Not Accent Rule",
        "body": "There is no accent token, and the contrast test asserts it. Selection is a lighter or raised surface plus weight; the primary action is an ink fill; focus is a 2px ink outline. Activation and rollback are pointer changes, so they are never painted red.",
        "section": "colors"
      },
      {
        "name": "The One Definition Rule",
        "body": "Each theme is defined exactly once, on `:root` and `:root[data-theme=\"dark\"]`. There is no second dark copy inside a media query to drift.",
        "section": "colors"
      },
      {
        "name": "The Mono Is Data Rule",
        "body": "Anything a developer might copy, compare or grep (build ids, paths, hashes, commands, ranges, counts) is mono with tabular figures. Prose and labels never are.",
        "section": "typography"
      },
      {
        "name": "The Quiet Label Rule",
        "body": "Labels are small, medium-weight, sentence case. No uppercase tracking, no labels above titles.",
        "section": "typography"
      },
      {
        "name": "The Scroll In Its Own Box Rule",
        "body": "Wide content (tables, long paths) scrolls inside its own positioned frame. The page never scrolls sideways, at any width or at 200% zoom.",
        "section": "layout"
      },
      {
        "name": "The Only Overlays Lift Rule",
        "body": "The soft offset overlay shadow belongs to the palette and the confirmation. Nothing else floats, and no surface nests inside another panel.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** carry selection, focus and the primary action with ink contrast and weight (the State-Only Colour Rule, the Ink, Not Accent Rule).",
      "**Do** put every id, path, hash, command, range and count in IBM Plex Mono with tabular figures.",
      "**Do** use 8px radius for controls and 12px for panels, with 1px hairlines.",
      "**Do** keep state colour beside a word, and give badges their 6px dot.",
      "**Do** time hover and selection changes at 150ms on `cubic-bezier(0.16, 1, 0.3, 1)`, and let reduced motion remove all of it.",
      "**Do** let wide content scroll inside its own frame.",
      "**Do** keep icons to the shell: authored 16px line icons at 1.5 stroke, each beside a word."
    ],
    "donts": [
      "**Don't** introduce an accent hue, or colour a button to make it important.",
      "**Don't** add inline SVG to route bodies: charts, gauges and scores drawn as bars are out. The budget tape is accounting with exact figures beside it.",
      "**Don't** use stat tiles or metric cards; facts are an aligned key-value list.",
      "**Don't** use decorative gradients or glass. The narrow-screen nav fade is a functional scroll cue, not ornament.",
      "**Don't** put the overlay shadow on anything but the palette and a confirmation, and don't nest panels.",
      "**Don't** fade a confirmation or any text a reader must read immediately; move it instead.",
      "**Don't** use uppercase tracked labels or a label above a title.",
      "**Don't** ship an unlabelled icon button."
    ]
  }
}
