        "purpose": "Contact shadow on resting surfaces in light theme; removed in dark."
      },
      {
        "name": "shadow-overlay",
        "value": "0 16px 48px -12px rgb(24 24 27 / 0.28), 0 2px 8px rgb(24 24 27 / 0.08)",
