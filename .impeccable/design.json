        "purpose": "Command palette and version confirmation only."
      },
      {
        "name": "focus-ring",
        "value": "outline: 2px solid var(--text); outline-offset: 2px",
        "purpose": "The one focus treatment, everywhere; inputs use offset 0 plus an ink border."
      }
    ],
    "motion": [
      {
        "name": "ease-out",
        "value": "cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "The only easing curve."
      },
      {
        "name": "state-change",
        "value": "150ms",
        "purpose": "Hover, selection and border changes on controls and nav. Row hover and copy reveal use 120ms."
      },
      {
        "name": "palette-rise",
        "value": "180ms; from opacity 0, translateY(-6px) scale(0.985)",
        "purpose": "Command palette reveal; scrim fades in 160ms."
      },
      {
        "name": "confirm-in",
        "value": "200ms; from translateY(4px), no opacity",
        "purpose": "Confirmations move and never fade."
      },
      {
        "name": "build-settle",
        "value": "600ms; from opacity 0.25, blur(2px)",
        "purpose": "The build id settles when a rebuild lands; the one unprompted motion."
      },
      {
        "name": "loading-pulse",
        "value": "1.2s ease-in-out infinite; dot to opacity 0.25",
        "purpose": "Indeterminate loading; no shimmer."
      },
      {
        "name": "reduced-motion",
        "value": "durations 0.01ms",
        "purpose": "prefers-reduced-motion removes every animation and transition."
      }
    ],
