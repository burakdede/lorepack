{
  "name": "lorepack",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned context build system for AI",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "pnpm build && vitest run",
    "acceptance": "pnpm build && vitest run --root tools/acceptance",
    "acceptance:docs": "pnpm --filter @lorepack/acceptance build && node scripts/generate-acceptance-doc.mjs",
    "acceptance:docs:check": "pnpm --filter @lorepack/acceptance build && node scripts/generate-acceptance-doc.mjs --check",
    "test:watch": "vitest",
    "check:no-native": "node scripts/check-no-native.mjs",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:no-native && pnpm check:no-em-dash && pnpm check:sources-tracked && pnpm schemas:check && pnpm acceptance:docs:check",
    "test:arch": "vitest run --project arch",
    "schemas:generate": "pnpm --filter @lorepack/core build && node scripts/generate-schemas.mjs",
    "schemas:check": "pnpm --filter @lorepack/core build && node scripts/generate-schemas.mjs --check",
    "probe:fts5": "node scripts/probe-fts5.mjs",
    "phase:check": "pnpm build && node scripts/phase-check.mjs",
    "test:unit": "vitest run",
    "check:sources-tracked": "node scripts/check-sources-tracked.mjs",
    "bench": "pnpm build && node scripts/bench.mjs",
    "check:command-set": "node scripts/check-command-set.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@changesets/cli": "2.31.1",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
