# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo

# Lorepack workspace state (never committed; see docs/package-format)
.lore/
*.lorepack

# test and coverage output
coverage/
*.log

# local agent/editor state
CLAUDE.local.md
.claude/settings.local.json
.vscode/*
!.vscode/mcp.json
.idea/

# OS cruft
.DS_Store
Thumbs.db

# Studio's built assets. Generated by `pnpm --filter @lorepack/studio build` into the CLI
# package, and published from there rather than committed.
packages/cli/studio-dist/

# Browser-driving artifacts: screenshots and page snapshots taken while checking a change.
.playwright-mcp/
*.png

# Playwright's own output from the browser suite: traces, screenshots and the HTML report.
tools/studio-e2e/test-results/
tools/studio-e2e/playwright-report/
