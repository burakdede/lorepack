# dependencies
node_modules/
.pnpm-store/

# build output
dist/
*.tsbuildinfo
# Anchored to the repo root. An unanchored `build/` matches at any depth, which silently
# swallowed `packages/backend-local/migrations/build/

# Migrations live in a directory called `build`, which is a word both this file and a
# contributor's personal global gitignore are likely to exclude at any depth. Re-including
# the directory explicitly is what makes a new migration commit on any machine: without it,
# `git add -A` silently skips the file and CI fails every test that opens a build database.
!packages/backend-local/migrations/build/0002_tables.sql`: a migration that
# existed locally, was never committed, and failed every test in CI. Ignore rules that can
# match a directory nobody was thinking about are worth spelling out.
/build/

# Migrations live in a directory called `build`, which is a word both this file and a
# contributor's personal global gitignore are likely to exclude at any depth. Re-including
# the directory explicitly is what makes a new migration commit on any machine: without it,
# `git add -A` silently skips the file and CI fails every test that opens a build database.
!packages/backend-local/migrations/build/

# Lorepack workspace state (never committed; see docs/package-format)
.lore/
*.lorepack

# test and coverage output
coverage/
*.log

# local agent/editor state
CLAUDE.local.md
.claude/settings.local.json
.vscode/*
!.vscode/mcp.json
.idea/

# OS cruft
.DS_Store
Thumbs.db

# Studio's built assets. Generated by `pnpm --filter @lorepack/studio build` into the CLI
# package, and published from there rather than committed.
packages/cli/studio-dist/

# Browser-driving artifacts: screenshots and page snapshots taken while checking a change.
.playwright-mcp/
*.png
# Except the documentation, which is generated on purpose by `pnpm docs:capture` and committed.
# The rule above is deliberately blunt so a screenshot dropped anywhere while debugging is not
# committed by accident, and blunt is why it silently swallowed six images the README needed
# and left it showing broken icons (#214). A negation rather than narrowing the rule, so the
# one directory that is allowed to hold a PNG has to say so.
!docs/images/*.png

# Playwright's own output from the browser suite: traces, screenshots and the HTML report.
tools/studio-e2e/test-results/
tools/studio-e2e/playwright-report/
