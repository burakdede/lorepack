{
  "$id": "https://lorepack.dev/schemas/search-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buildId": {
      "description": "Content-derived build identifier",
      "pattern": "^lore_[0-9a-f]{64}$",
      "type": "string"
    },
    "hits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "minLength": 1,
            "type": "string"
          },
          "chunkId": {
            "minLength": 1,
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          },
          "headingPath": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "labels": {
            "items": {
              "enum": [
                "draft",
                "archived",
                "superseded"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "locator": {
            "additionalProperties": false,
            "description": "Exact location of content within a source artifact",
            "properties": {
              "artifactId": {
                "minLength": 1,
                "type": "string"
              },
              "cellRange": {
                "type": "string"
              },
              "headingPath": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "lineEnd": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "lineStart": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "page": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "relativePath": {
                "description": "POSIX-style path relative to a source root",
                "minLength": 1,
                "type": "string"
              },
              "sheet": {
                "type": "string"
              }
            },
            "required": [
              "artifactId",
              "relativePath"
            ],
            "type": "object"
          },
          "score": {
            "type": "number"
          },
          "scoreComponents": {
            "additionalProperties": {
              "type": "number"
            },
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "status": {
            "enum": [
              "active",
              "draft",
              "archived"
            ],
            "type": "string"
          }
        },
        "required": [
          "chunkId",
          "artifactId",
          "score",
          "excerpt",
          "headingPath",
          "status",
          "labels",
          "locator"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "sourceState": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ],
      "type": "string"
    },
    "totalIndexedChunks": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "buildId",
    "sourceState",
    "hits",
    "totalIndexedChunks"
  ],
  "title": "search-result",
  "type": "object"
}
