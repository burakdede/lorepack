{
  "$id": "https://lorepack.dev/schemas/build-description.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buildId": {
      "description": "Content-derived build identifier",
      "pattern": "^lore_[0-9a-f]{64}$",
      "type": "string"
    },
    "capabilities": {
      "items": {
        "enum": [
          "lexical-search",
          "structured-context",
          "table-query",
          "semantic-search"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "compilerVersion": {
      "minLength": 1,
      "type": "string"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "chunks": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "nodes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "tableRows": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "tables": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "artifacts",
        "nodes",
        "chunks",
        "tables",
        "tableRows"
      ],
      "type": "object"
    },
    "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "projectName": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "shortBuildId": {
      "minLength": 1,
      "type": "string"
    },
    "sourceState": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ],
      "type": "string"
    },
    "warningCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "buildId",
    "sourceState",
    "projectName",
    "shortBuildId",
    "capabilities",
    "counts",
    "warningCount",
    "schemaVersion",
    "compilerVersion"
  ],
  "title": "build-description",
  "type": "object"
}
