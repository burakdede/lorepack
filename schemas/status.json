{
  "$id": "https://lorepack.dev/schemas/status.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activeBuildAt": {
      "anyOf": [
        {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeBuildId": {
      "anyOf": [
        {
          "description": "Content-derived build identifier",
          "pattern": "^lore_[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "changed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "total",
        "added",
        "changed",
        "removed"
      ],
      "type": "object"
    },
    "buildAgeSeconds": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "enum": [
              "added",
              "changed",
              "removed",
              "reused"
            ],
            "type": "string"
          },
          "path": {
            "description": "POSIX-style path relative to a source root",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path",
          "change"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "decidedBy": {
      "const": "content-hash",
      "type": "string"
    },
    "formatVersion": {
      "const": 1,
      "type": "number"
    },
    "projectName": {
      "minLength": 1,
      "type": "string"
    },
    "remediation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceState": {
      "enum": [
        "clean",
        "dirty",
        "unbuilt"
      ],
      "type": "string"
    },
    "warnings": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "formatVersion",
    "projectName",
    "activeBuildId",
    "activeBuildAt",
    "buildAgeSeconds",
    "sourceState",
    "decidedBy",
    "artifacts",
    "changes",
    "warnings",
    "remediation"
  ],
  "title": "status",
  "type": "object"
}
