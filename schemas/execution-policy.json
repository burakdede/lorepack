          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lorepack.dev/schemas/execution-policy.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
