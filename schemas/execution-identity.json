{
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "items": {
            "$ref": "#/$defs/__schema0"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      ]
    }
  },
  "$id": "https://lorepack.dev/schemas/execution-identity.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "additionalProperties": false,
      "properties": {
        "canonicalizationVersion": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "estimator": {
          "additionalProperties": false,
          "properties": {
            "bytesPerToken": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "compilerVersion": {
              "minLength": 1,
              "type": "string"
            },
            "mode": {
              "const": "serialized-utf8-estimate",
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "wordFloor": {
              "const": "whitespace-words",
              "type": "string"
            }
          },
          "required": [
            "version",
            "mode",
            "bytesPerToken",
            "wordFloor",
            "compilerVersion"
          ],
          "type": "object"
        },
        "packing": {
          "additionalProperties": false,
          "properties": {
            "budget": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maximumAlternatives": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "maximumItemsPerArtifact": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maximumNativeUnitBytes": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maximumOmissionDetails": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "orientationShare": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            "profile": {
              "enum": [
                "agent",
                "coding",
                "chat",
                "deep"
              ],
              "type": "string"
            },
            "unit": {
              "enum": [
                "whole-chunk",
                "native-unit"
              ],
              "type": "string"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "profile",
            "budget",
            "orientationShare",
            "maximumItemsPerArtifact",
            "maximumAlternatives",
            "maximumOmissionDetails",
            "unit"
          ],
          "type": "object"
        },
        "retrieval": {
          "additionalProperties": false,
          "properties": {
            "normalization": {
              "const": "fts5-unicode61",
              "type": "string"
            },
            "queryVersion": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "rankingVersion": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "weights": {
              "$ref": "#/$defs/__schema0"
            },
            "weightsVersion": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "normalization",
            "queryVersion",
            "rankingVersion",
            "weightsVersion",
            "weights"
          ],
          "type": "object"
        },
        "serialization": {
          "additionalProperties": false,
          "properties": {
            "format": {
              "const": "bounded-supported-formats",
              "type": "string"
            },
            "maximumBytes": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "maximumProjectNameLength": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            },
            "receipt": {
              "additionalProperties": false,
              "properties": {
                "captureRequest": {
                  "type": "boolean"
                },
                "maximumBytes": {
                  "const": 4096,
                  "type": "number"
                },
                "version": {
                  "const": 1,
                  "type": "number"
                }
              },
              "required": [
                "version",
                "maximumBytes",
                "captureRequest"
              ],
              "type": "object"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "format",
            "maximumBytes",
            "maximumProjectNameLength"
          ],
          "type": "object"
        },
        "version": {
          "const": 1,
          "type": "number"
        },
        "visibility": {
          "additionalProperties": false,
          "properties": {
            "default": {
              "enum": [
                "current-preferred-with-historical-fallback",
                "current-only"
              ],
              "type": "string"
            },
            "drafts": {
              "const": "eligible-labeled-downranked",
              "type": "string"
            },
            "includeArchived": {
              "type": "boolean"
            },
            "version": {
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991,
              "type": "integer"
            }
          },
          "required": [
            "version",
            "default",
            "includeArchived",
            "drafts"
          ],
          "type": "object"
        }
      },
      "required": [
        "version",
        "canonicalizationVersion",
        "retrieval",
        "packing",
        "estimator",
        "visibility",
        "serialization"
      ],
      "type": "object"
    },
    "policyId": {
      "pattern": "^policy_[a-f0-9]{64}$",
      "type": "string"
    },
    "selection": {
      "additionalProperties": false,
      "properties": {
        "buildId": {
          "description": "Content-derived build identifier",
          "pattern": "^lore_[0-9a-f]{64}$",
          "type": "string"
        },
        "corpusId": {
          "pattern": "^corpus_[0-9a-f]{32}$",
          "type": "string"
        },
        "filters": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "path",
                  "type",
                  "status"
                ],
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "namespaceId": {
          "pattern": "^namespace_[0-9a-f]{32}$",
          "type": "string"
        },
        "task": {
          "maxLength": 4000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "corpusId",
        "namespaceId",
        "buildId",
        "task",
        "filters"
      ],
      "type": "object"
    },
    "selectionId": {
      "pattern": "^selection_[a-f0-9]{64}$",
      "type": "string"
    },
    "version": {
      "const": 1,
      "type": "number"
    }
  },
  "required": [
    "version",
    "policyId",
    "selectionId",
    "policy",
    "selection"
  ],
  "title": "execution-identity",
  "type": "object"
}
