{
  "$id": "https://lorepack.dev/schemas/source-list-result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "minLength": 1,
            "type": "string"
          },
          "authority": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "byteSize": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "chunkCount": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "displayPath": {
            "type": "string"
          },
          "locator": {
            "additionalProperties": false,
            "description": "Exact location of content within a source artifact",
            "properties": {
              "artifactId": {
                "minLength": 1,
                "type": "string"
              },
              "cellRange": {
                "type": "string"
              },
              "headingPath": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "lineEnd": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "lineStart": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "page": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer"
              },
              "relativePath": {
                "description": "POSIX-style path relative to a source root",
                "minLength": 1,
                "type": "string"
              },
              "sheet": {
                "type": "string"
              }
            },
            "required": [
              "artifactId",
              "relativePath"
            ],
            "type": "object"
          },
          "mediaType": {
            "type": "string"
          },
          "nodeCount": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "objectHash": {
            "type": "string"
          },
          "parserId": {
            "type": "string"
          },
          "relativePath": {
            "description": "POSIX-style path relative to a source root",
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "draft",
              "archived"
            ],
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "artifactId",
          "relativePath",
          "displayPath",
          "title",
          "status",
          "authority",
          "mediaType",
          "objectHash",
          "byteSize",
          "parserId",
          "chunkCount",
          "nodeCount",
          "locator"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    },
    "buildId": {
      "description": "Content-derived build identifier",
      "pattern": "^lore_[0-9a-f]{64}$",
      "type": "string"
    },
    "corpusId": {
      "pattern": "^corpus_[0-9a-f]{32}$",
      "type": "string"
    },
    "namespaceId": {
      "pattern": "^namespace_[0-9a-f]{32}$",
      "type": "string"
    },
    "nextOffset": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceState": {
      "enum": [
        "clean",
        "dirty",
        "unknown"
      ],
      "type": "string"
    }
  },
  "required": [
    "corpusId",
    "namespaceId",
    "buildId",
    "sourceState",
    "artifacts",
    "nextOffset"
  ],
  "title": "source-list-result",
  "type": "object"
}
