{
  "$id": "https://lorepack.dev/schemas/source-list-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buildId": {
      "description": "Content-derived build identifier",
      "pattern": "^lore_[0-9a-f]{64}$",
      "type": "string"
    },
    "limit": {
      "default": 50,
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
    },
    "offset": {
      "default": 0,
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "source-list-request",
  "type": "object"
}
