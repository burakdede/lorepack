{
  "$id": "https://lorepack.dev/schemas/build-receipt.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "buildId": {
      "description": "Content-derived build identifier",
      "pattern": "^lore_[0-9a-f]{64}$",
      "type": "string"
    },
    "cache": {
      "additionalProperties": false,
      "properties": {
        "rebuiltArtifacts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "reusedArtifacts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "reusedArtifacts",
        "rebuiltArtifacts"
      ],
      "type": "object"
    },
    "completedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    },
    "durationMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "nodeVersion": {
      "minLength": 1,
      "type": "string"
    },
    "platform": {
      "minLength": 1,
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
    }
  },
  "required": [
    "buildId",
    "startedAt",
    "completedAt",
    "durationMs",
    "cache",
    "platform",
    "nodeVersion"
  ],
  "title": "build-receipt",
  "type": "object"
}
